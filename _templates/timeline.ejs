<%
// One row per stage, used by the homepage path and the About experience.
// Quarto runs this as a lodash template, so <%= prints raw text and <%- would escape the markup.
// Reads dates, title, optional role, description (Markdown works) and optional href (links the title) from a YAML item.
const esc = (value) => String(value ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const rows = items.map((item) => {
  const href = item.href ?? "";
  const link = /^https?:/.test(href) ? ` class="title-link" target="_blank" rel="noopener"` : ` class="title-link no-external"`;
  const title = href ? `<a href="${esc(href)}"${link}>${item.title}</a>` : item.title;
  return `<li class="tl-row">
<p class="tl-dates">${esc(item.dates)}</p>
<div class="tl-body">
<h3 class="tl-title no-anchor">${title}</h3>
${item.role ? `<p class="tl-role">${esc(item.role)}</p>` : ""}
<p class="tl-text">${item.description ?? ""}</p>
</div>
</li>`;
});
%>

```{=html}
<ol class="timeline">
<%= rows.join("\n") %>
</ol>
```
