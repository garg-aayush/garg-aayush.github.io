<ul class="work-rows"><% for (const item of items) { %>
<li class="work-row">
<h3 class="work-name no-anchor"><a href="<%- item.path %>" target="_blank" rel="noopener"><%- item.title %></a></h3>
<div class="work-body">
<p><%- item.description %></p><% if (item.list) { %>
<ul><% for (const entry of item.list) { %>
<li><%= entry %></li><% } %>
</ul><% } %><% if (item.note) { %>
<p><%= item.note %></p><% } %>
</div>
</li><% } %>
</ul>
