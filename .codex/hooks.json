{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agent_hooks/prompt-secrets.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking prompt for secrets"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agent_hooks/bash-guard.mjs\" --codex",
            "timeout": 5,
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agent_hooks/edit-checks.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking edited files"
          }
        ]
      }
    ]
  }
}
